# Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets Spreadsheet ID Utama (Tempat database pelanggan berada)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Opsional: Jika sheet Pemasukan dan Pengeluaran dipisahkan di file Spreadsheet yang berbeda, isi di bawah ini.
# Jika berada di file yang sama dengan database pelanggan, kosongkan atau samakan dengan ID di atas.
GOOGLE_SPREADSHEET_ID_PEMASUKAN=your_google_spreadsheet_id_pemasukan_here
GOOGLE_SPREADSHEET_ID_PENGELUARAN=your_google_spreadsheet_id_pengeluaran_here

# ImgBB API Key (Dapatkan gratis dengan mendaftar di https://imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key_here

# Google Service Account Credentials
# Salin nilai ini dari file JSON credentials yang diunduh dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyValueHere...\n-----END PRIVATE KEY-----\n"
